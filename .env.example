# Copy to .env (git-ignored). Never commit real keys.
ANTHROPIC_API_KEY=
# only needed if the key is organization-level rather than workspace-scoped (Console -> Workspaces -> the workspace ID)
ANTHROPIC_WORKSPACE_ID=
# optional, Muse Spark stretch adapter
META_API_KEY=
# optional, ALFRED vintages for E19
FRED_API_KEY=
# record | replay | scripted   (make demo forces replay)
TRACKBACK_LLM_MODE=replay
